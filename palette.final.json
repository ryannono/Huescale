{
  "$description": "Blueprint BP7 intent palette (final). Light = orange appearance pattern transformed onto each hue's 500 anchor; grey from gray-source.json. Dark = CIECAM02 simultaneous-contrast compensation (#ffffff→#000000, Yb=15). white/black are fixed alpha ramps.",
  "formula": {
    "light": {
      "method": "optical-appearance-transform",
      "sourcePattern": "patterns/default.json",
      "reference": "#BD5200",
      "anchorStop": 500,
      "hueAnchors": {
        "orange": "#BD5200",
        "blue": "#2D72D2",
        "green": "#008F37",
        "red": "#CD4246"
      }
    },
    "grey": {
      "method": "helmholtz-kohlrausch (hue 257, chroma 0.025) off the orange reference; 800–1000 hand-tuned",
      "source": "patterns/gray-source.json"
    },
    "dark": {
      "method": "ciecam02-contrast-compensation",
      "sourceBg": "#ffffff",
      "targetBg": "#000000",
      "yb": 15
    },
    "alphaRamps": {
      "white": {
        "base": "#ffffff",
        "light": [
          0.06,
          0.12,
          0.2,
          0.3,
          0.5,
          0.8,
          0.85,
          0.9,
          0.95,
          1
        ],
        "dark": [
          0.07,
          0.11,
          0.16,
          0.3,
          0.5,
          0.8,
          0.85,
          0.9,
          0.95,
          1
        ]
      },
      "black": {
        "base": "#000105",
        "light": [
          0.025,
          0.09,
          0.12,
          0.3,
          0.5,
          0.8,
          0.85,
          0.9,
          0.95,
          1
        ],
        "dark": [
          0.03,
          0.1,
          0.2,
          0.3,
          0.5,
          0.8,
          0.85,
          0.9,
          0.95,
          1
        ]
      }
    }
  },
